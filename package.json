{
  "name": "karhutla-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/banjir-ringkasan.mjs && vite build && npm run build:v2 && npm run build:v3",
    "build:v2": "VITE_EDITION=v2 vite build --config vite.v2.config.js",
    "build:v3": "VITE_EDITION=v3 vite build --config vite.v3.config.js",
    "dev:v2": "VITE_EDITION=v2 vite --config vite.v2.config.js --host 127.0.0.1 --port 5174",
    "dev:v3": "VITE_EDITION=v3 vite --config vite.v3.config.js --host 127.0.0.1 --port 5175",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "node scripts/self-check.mjs",
    "refresh-data": "node scripts/refresh-live-data.mjs",
    "generate-sample": "node scripts/generate-sample.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "topojson-server": "^3.0.1",
    "vite": "^6.2.0"
  }
}
